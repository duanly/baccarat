<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 企业签直装：method=enterprise；TestFlight 用 app-store；Ad Hoc 用 ad-hoc -->
  <key>method</key><string>enterprise</string>
  <key>teamID</key><string>YOUR_TEAM_ID</string>
  <key>signingStyle</key><string>automatic</string>
  <key>compileBitcode</key><false/>
  <key>stripSwiftSymbols</key><true/>
  <key>thinning</key><string>&lt;none&gt;</string>
  <!-- 生成 itms-services 安装清单（OTA 网页安装用） -->
  <key>manifest</key>
  <dict>
    <key>appURL</key><string>https://dl.yourdomain.com/Baccarat.ipa</string>
    <key>displayImageURL</key><string>https://dl.yourdomain.com/icon57.png</string>
    <key>fullSizeImageURL</key><string>https://dl.yourdomain.com/icon512.png</string>
  </dict>
</dict>
</plist>
